# ============================================================
# 星灵花园后端环境配置模板
# 复制为 .env 并填写真实值（.env 已被 gitignore，绝不提交）。
# 已存在的系统环境变量优先于 .env。
# ============================================================

# --- 高德地图 Geocoding（生产必需）---
# 用于出生地 → 经纬度 + 时区解析。在高德开放平台申请「Web服务」key。
# 不配置 → 回退到内置主要城市表（仅覆盖大城市，小城市解析失败会报 422）。
GS_AMAP_KEY=
# 显式离线：设 1 跳过高德仅用静态表（CI/无网环境用；正常部署不设）
GS_GEOCODE_OFFLINE=

# --- 加密密钥（生产必需）---
# 出生数据 Fernet 加密密钥（base64 url-safe，`python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成）。
# 不配置 → 自动生成随机密钥，重启后历史数据不可解密（仅限开发）。
GS_ENCRYPTION_KEY=

# --- LLM（可选，配置后启用意图拆解 + 叙事合成）---
# provider: openai | anthropic | google（openai 兼容协议）
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
# 显式禁用 LLM（CI/测试用；正常部署不设）
GS_LLM_DISABLE=

# --- Web Push 通知（VAPID 密钥对，生产必需）---
# 生成密钥对：
#   python -c "from cryptography.hazmat.primitives.asymmetric import ec; from cryptography.hazmat.primitives import serialization; import base64; k=ec.generate_private_key(ec.SECP256R1()); print('GS_VAPID_PRIVATE_KEY='+base64.urlsafe_b64encode(k.private_bytes(serialization.Encoding.DER, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())).decode().rstrip('=')); print('GS_VAPID_PUBLIC_KEY='+base64.urlsafe_b64encode(k.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)).decode().rstrip('='))"
# 不配置 → 推送发送会失败但服务不炸（trigger 返回 pushed=0）。
GS_VAPID_PRIVATE_KEY=
GS_VAPID_PUBLIC_KEY=
GS_VAPID_SUBJECT=mailto:admin@garden-spirit.app
